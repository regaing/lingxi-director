# ---- 依赖 ----
node_modules/

# ---- 本地配置（含密钥，绝不入库）----
config.json
config.json.bak
.env
.env.*

# ---- 运行时数据（SQLite：图 / 分类 / 通知 / 运行记录）----
data/
*.db
*.db-shm
*.db-wal

# ---- 前端构建产物（由 npm run build 生成）----
public/

# ---- 运行时落盘（产物 / 上传素材 / 手工产出）----
downloads/
assets/
out/

# ---- 旧版 JSON 迁移归档位 ----
workflows/_imported/

# ---- 日志与临时 ----
*.log
npm-debug.log*
.run/
tmp/
.tmp/

# ---- 编辑器 / 操作系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
